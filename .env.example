# Copy to .env.local and fill in. Never commit .env.local.

# ── Site ───────────────────────────────────────────────────────────────
# Live URL. Used for canonical tags, sitemap, and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://adrealestate.pk

# ── Sanity (CMS + enquiry inbox) ───────────────────────────────────────
# From sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Editor token with WRITE access — server-side only, never exposed to browsers.
# Create at sanity.io/manage → API → Tokens.
SANITY_API_WRITE_TOKEN=

# ── Lead notification email (optional but recommended) ─────────────────
# Without these, enquiries still save to the Studio but no email is sent.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@adgroupofcompanies.pk
# Must be a domain verified in Resend.
LEAD_FROM_EMAIL=enquiries@adrealestate.pk
